resolve highest org.apache.maven.resolver:maven-resolver-spi:[1.7.0,2.0.0);
resolve highest org.apache.maven:maven-resolver-provider:[3.8.1,4.0.0);

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

