// SMX Nexus Repository
repository https://nexus.az1.smxk8s.net/repository/maven-releases/;
repository https://repo1.maven.org/maven2/ as central;

import smx3:smx3.bill-of-materials:4.2.45;

allow unlocked /^.*smx.*$/;

resolve highest org.antlr:antlr4-maven-plugin:[4.13.2,5.0.0) via central;
resolve highest org.antlr:antlr4-runtime:[4.13.2,5.0.0) via central;
resolve highest com.google.truth:truth:[1.4.5,2.0) via central;
resolve highest io.vavr:vavr:[1.0.1,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest io.cucumber:cucumber-java:[7.34.3,8.0.0) via central;
resolve highest io.cucumber:cucumber-junit:[7.34.3,8.0.0) via central;
resolve highest com.google.truth.extensions:truth-java8-extension:[1.4.5,2.0.0) via central;
resolve highest junit:junit:[4.13.2,5.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-api:[1.9.27,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-connector-basic:[1.9.27,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-impl:[1.9.27,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-transport-file:[1.9.27,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-transport-http:[1.9.27,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-util:[1.9.27,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-spi:[1.9.27,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven:maven-resolver-provider:[3.9.16,4.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

locked com.diffplug.spotless:spotless-maven-plugin:3.7.0;
locked com.google.guava:failureaccess:1.0.3;
locked com.google.guava:guava:33.6.0-jre;
locked com.google.truth.extensions:truth-java8-extension:1.4.5;
locked com.google.truth:truth:1.4.5;
locked com.palantir.javaformat:palantir-java-format:2.93.0;
locked com.smxemail.tiles:com.smxemail.tiles.enforcements:5.0.31;
locked com.smxemail.tiles:com.smxemail.tiles.release:2.2.126;
locked io.cucumber:cucumber-java:7.34.3;
locked io.cucumber:cucumber-junit:7.34.3;
locked io.repaint.maven:tiles-maven-plugin:2.44;
locked io.vavr:vavr:1.0.1;
locked junit:junit:4.13.2;
locked org.antlr:antlr4-maven-plugin:4.13.2;
locked org.antlr:antlr4-runtime:4.13.2;
locked org.apache.commons:commons-lang3:3.20.0;
locked org.apache.maven.plugins:maven-assembly-plugin:3.8.0;
locked org.apache.maven.plugins:maven-deploy-plugin:3.1.4;
locked org.apache.maven.plugins:maven-failsafe-plugin:3.6.0-M1;
locked org.apache.maven.plugins:maven-install-plugin:3.1.4;
locked org.apache.maven.plugins:maven-jar-plugin:3.5.0;
locked org.apache.maven.plugins:maven-site-plugin:3.22.0;
locked org.apache.maven.plugins:maven-source-plugin:3.4.0;
locked org.apache.maven.plugins:maven-surefire-plugin:3.6.0-M1;
locked org.apache.maven.resolver:maven-resolver-api:1.9.27;
locked org.apache.maven.resolver:maven-resolver-connector-basic:1.9.27;
locked org.apache.maven.resolver:maven-resolver-impl:1.9.27;
locked org.apache.maven.resolver:maven-resolver-spi:1.9.27;
locked org.apache.maven.resolver:maven-resolver-transport-file:1.9.27;
locked org.apache.maven.resolver:maven-resolver-transport-http:1.9.27;
locked org.apache.maven.resolver:maven-resolver-util:1.9.27;
locked org.apache.maven:maven-artifact:3.9.16;
locked org.apache.maven:maven-resolver-provider:3.9.16;
locked org.bitbucket.cowwoc:diff-match-patch:1.2;
locked org.immutables:value:2.12.2;
