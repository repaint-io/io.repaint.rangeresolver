// SMX Nexus Repository
repository https://nexus.az1.smxk8s.net/repository/maven-releases/;
repository https://repo1.maven.org/maven2/ as central;

import smx3:smx3.bill-of-materials:3.3.151;

allow unlocked /^.*smx.*$/;

resolve highest com.google.truth:truth:[1.1.3,2.0) via central;
resolve highest io.vavr:vavr:[1.0.0-alpha-4,2.0.0) via central;
resolve highest io.cucumber:cucumber-java:[7.0.0-RC1,7.0.0) via central;
resolve highest io.cucumber:cucumber-junit:[7.0.0-RC1,7.0.0) via central;
resolve highest com.google.truth.extensions:truth-java8-extension:[1.1.3,2.0.0) via central;
resolve highest junit:junit:[4.13.2,5.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-api:[1.8.0,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-connector-basic:[1.8.0,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-impl:[1.8.0,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-transport-file:[1.8.0,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-transport-http:[1.8.0,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-util:[1.8.0,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-spi:[1.8.0,2.0.0) via central;
resolve highest org.apache.maven:maven-resolver-provider:[3.8.5,4.0.0) via central;

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

locked com.github.sviperll:adt4j:3.2;
locked com.google.auto.value:auto-value:1.9;
locked com.google.guava:failureaccess:1.0.1;
locked com.google.guava:guava:31.1-jre;
locked com.google.truth.extensions:truth-java8-extension:1.1.3;
locked com.google.truth:truth:1.1.3;
locked com.smxemail.tiles:com.smxemail.tiles.enforcements:3.2.127;
locked com.smxemail.tiles:com.smxemail.tiles.release:2.2.45;
locked com.smxemail:com.smxemail.datatype.annotations:1.0.2;
locked com.smxemail:com.smxemail.errorprone.checks:1.0.36;
locked io.cucumber:cucumber-java:7.0.0-RC1;
locked io.cucumber:cucumber-junit:7.0.0-RC1;
locked io.repaint.maven:tiles-maven-plugin:2.27;
locked io.vavr:vavr:1.0.0-alpha-4;
locked junit:junit:4.13.2;
locked org.antlr:antlr4-maven-plugin:4.9.3;
locked org.antlr:antlr4-runtime:4.9.3;
locked org.apache.commons:commons-lang3:3.12.0;
locked org.apache.maven.plugins:maven-jar-plugin:3.2.2;
locked org.apache.maven.plugins:maven-source-plugin:3.2.1;
locked org.apache.maven.resolver:maven-resolver-api:1.8.0;
locked org.apache.maven.resolver:maven-resolver-connector-basic:1.8.0;
locked org.apache.maven.resolver:maven-resolver-impl:1.8.0;
locked org.apache.maven.resolver:maven-resolver-spi:1.8.0;
locked org.apache.maven.resolver:maven-resolver-transport-file:1.8.0;
locked org.apache.maven.resolver:maven-resolver-transport-http:1.8.0;
locked org.apache.maven.resolver:maven-resolver-util:1.8.0;
locked org.apache.maven:maven-artifact:3.8.5;
locked org.apache.maven:maven-resolver-provider:3.8.5;
locked org.bitbucket.cowwoc:diff-match-patch:1.2;
locked org.codehaus.mojo:build-helper-maven-plugin:3.3.0;
locked org.immutables:value:2.9.0;
locked org.jacoco:jacoco-maven-plugin:0.8.8;
locked org.jetbrains:annotations:23.0.0;
