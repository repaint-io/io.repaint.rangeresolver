// SMX Nexus Repository
repository https://nexus.az1.smxk8s.net/repository/maven-releases/;
repository https://repo1.maven.org/maven2/ as central;

import smx3:smx3.bill-of-materials:3.5.3-SNAPSHOT;

allow unlocked /^.*smx.*$/;

resolve highest com.google.truth:truth:[1.1.5,2.0) via central;
resolve highest io.vavr:vavr:[1.0.0-alpha-4,2.0.0) via central;
resolve highest io.cucumber:cucumber-java:[7.12.1,8.0.0) via central;
resolve highest io.cucumber:cucumber-junit:[7.12.1,8.0.0) via central;
resolve highest com.google.truth.extensions:truth-java8-extension:[1.1.5,2.0.0) via central;
resolve highest junit:junit:[4.13.2,5.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-api:[1.9.12,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-connector-basic:[1.9.12,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-impl:[1.9.12,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-transport-file:[1.9.12,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-transport-http:[1.9.12,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-util:[1.9.12,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-spi:[1.9.12,2.0.0) via central;
resolve highest org.apache.maven:maven-resolver-provider:[3.9.2,4.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

locked com.github.sviperll:adt4j:3.2;
locked com.google.auto.value:auto-value:1.10.1;
locked com.google.guava:failureaccess:1.0.1;
locked com.google.guava:guava:32.0.1-jre;
locked com.google.truth.extensions:truth-java8-extension:1.1.5;
locked com.google.truth:truth:1.1.5;
locked com.smxemail.tiles:com.smxemail.tiles.enforcements:3.2.169;
locked com.smxemail.tiles:com.smxemail.tiles.release:2.2.83;
locked com.smxemail:com.smxemail.datatype.annotations:1.0.3;
locked com.smxemail:com.smxemail.errorprone.checks:1.0.37;
locked io.cucumber:cucumber-java:7.12.1;
locked io.cucumber:cucumber-junit:7.12.1;
locked io.repaint.maven:tiles-maven-plugin:2.36;
locked io.vavr:vavr:1.0.0-alpha-4;
locked junit:junit:4.13.2;
locked org.antlr:antlr4-maven-plugin:4.9.3;
locked org.antlr:antlr4-runtime:4.9.3;
locked org.apache.commons:commons-lang3:3.12.0;
locked org.apache.maven.plugins:maven-assembly-plugin:3.6.0;
locked org.apache.maven.plugins:maven-failsafe-plugin:3.1.2;
locked org.apache.maven.plugins:maven-install-plugin:3.1.1;
locked org.apache.maven.plugins:maven-jar-plugin:3.3.0;
locked org.apache.maven.plugins:maven-source-plugin:3.3.0;
locked org.apache.maven.plugins:maven-surefire-plugin:3.1.2;
locked org.apache.maven.resolver:maven-resolver-api:1.9.12;
locked org.apache.maven.resolver:maven-resolver-connector-basic:1.9.12;
locked org.apache.maven.resolver:maven-resolver-impl:1.9.12;
locked org.apache.maven.resolver:maven-resolver-spi:1.9.12;
locked org.apache.maven.resolver:maven-resolver-transport-file:1.9.12;
locked org.apache.maven.resolver:maven-resolver-transport-http:1.9.12;
locked org.apache.maven.resolver:maven-resolver-util:1.9.12;
locked org.apache.maven:maven-artifact:3.9.2;
locked org.apache.maven:maven-resolver-provider:3.9.2;
locked org.bitbucket.cowwoc:diff-match-patch:1.2;
locked org.codehaus.mojo:build-helper-maven-plugin:3.4.0;
locked org.immutables:value:2.9.3;
locked org.jacoco:jacoco-maven-plugin:0.8.10;
locked org.jetbrains:annotations:24.0.1;
