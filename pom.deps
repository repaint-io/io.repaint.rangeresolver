// SMX Nexus Repository
repository http://nexus.smxemail.com/nexus/content/repositories/releases/;
repository http://nexus.smxemail.com/nexus/content/groups/public/ as public;

import smx3:smx3.bill-of-materials:3.3.40;

allow unlocked /^.*smx.*$/;

resolve highest com.google.truth:truth:[1.1.3,2.0) via public;
resolve highest io.vavr:vavr:[1.0.0-alpha-3,2.0.0) via public;
resolve highest io.cucumber:cucumber-java:[6.10.4,7.0.0) via public;
resolve highest io.cucumber:cucumber-junit:[6.10.4,7.0.0) via public;
resolve highest com.google.truth.extensions:truth-java8-extension:[1.0,2.0.0);
resolve highest junit:junit:[4.12,5.0.0);
resolve highest org.apache.maven.resolver:maven-resolver-api:[1.7.0,2.0.0);
resolve highest org.apache.maven.resolver:maven-resolver-connector-basic:[1.7.0,2.0.0);
