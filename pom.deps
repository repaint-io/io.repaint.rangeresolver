// SMX Nexus Repository
repository https://nexus.az1.smxk8s.net/repository/maven-releases/;
repository https://repo1.maven.org/maven2/ as central;

import smx3:smx3.bill-of-materials:3.4.20;

allow unlocked /^.*smx.*$/;

resolve highest com.google.truth:truth:[1.1.3,2.0) via central;
resolve highest io.vavr:vavr:[1.0.0-alpha-4,2.0.0) via central;
resolve highest io.cucumber:cucumber-java:[7.11.1,8.0.0) via central;
resolve highest io.cucumber:cucumber-junit:[7.11.1,8.0.0) via central;
resolve highest com.google.truth.extensions:truth-java8-extension:[1.1.3,2.0.0) via central;
resolve highest junit:junit:[4.13.2,5.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-api:[1.9.4,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-connector-basic:[1.9.4,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-impl:[1.9.4,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-transport-file:[1.9.4,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-transport-http:[1.9.4,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-util:[1.9.4,2.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-spi:[1.9.4,2.0.0) via central;
resolve highest org.apache.maven:maven-resolver-provider:[3.8.7,4.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

resolved com.smxemail.tiles:com.smxemail.tiles.enforcements:3.2.142;
resolved com.smxemail.tiles:com.smxemail.tiles.release:2.2.62;
resolved com.smxemail:com.smxemail.datatype.annotations:1.0.3;
resolved com.smxemail:com.smxemail.errorprone.checks:1.0.37;
resolved org.apache.maven.resolver:maven-resolver-api:1.9.4;
resolved org.apache.maven.resolver:maven-resolver-connector-basic:1.9.4;
resolved org.apache.maven.resolver:maven-resolver-impl:1.9.4;
resolved org.apache.maven.resolver:maven-resolver-spi:1.9.4;
resolved org.apache.maven.resolver:maven-resolver-transport-file:1.9.4;
resolved org.apache.maven.resolver:maven-resolver-transport-http:1.9.4;
resolved org.apache.maven.resolver:maven-resolver-util:1.9.4;
resolved org.apache.maven:maven-resolver-provider:3.8.7;

