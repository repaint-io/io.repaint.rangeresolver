// SMX Nexus Repository
repository https://nexus.az1.smxk8s.net/repository/maven-releases/;
repository https://repo1.maven.org/maven2/ as central;

import smx3:smx3.bill-of-materials:4.0.9;

allow unlocked /^.*smx.*$/;

resolve highest org.antlr:antlr4-maven-plugin:[4.13.2,5.0.0) via central;
resolve highest org.antlr:antlr4-runtime:[4.13.2,5.0.0) via central;
resolve highest com.google.truth:truth:[1.4.5,2.0) via central;
resolve highest io.vavr:vavr:[0.10.7,1.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest io.cucumber:cucumber-java:[7.29.0,8.0.0) via central;
resolve highest io.cucumber:cucumber-junit:[7.29.0,8.0.0) via central;
resolve highest com.google.truth.extensions:truth-java8-extension:[1.4.5,2.0.0) via central;
resolve highest junit:junit:[4.13.2,5.0.0) via central;
resolve highest org.apache.maven.resolver:maven-resolver-api:[1.9.24,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-connector-basic:[1.9.24,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-impl:[1.9.24,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-transport-file:[1.9.24,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-transport-http:[1.9.24,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-util:[1.9.24,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven.resolver:maven-resolver-spi:[1.9.24,2.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;
resolve highest org.apache.maven:maven-resolver-provider:[3.9.11,4.0.0) via central filtering /^.*(ea|alpha|beta|rc|pr|SNAPSHOT).*$/;

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

locked com.diffplug.spotless:spotless-maven-plugin:2.46.1;
locked com.google.guava:failureaccess:1.0.3;
locked com.google.guava:guava:33.5.0-jre;
locked com.google.truth.extensions:truth-java8-extension:1.4.5;
locked com.google.truth:truth:1.4.5;
locked com.palantir.javaformat:palantir-java-format:2.74.0;
locked com.smxemail.tiles:com.smxemail.tiles.enforcements:4.1.25;
locked com.smxemail.tiles:com.smxemail.tiles.release:2.2.117;
locked io.cucumber:cucumber-java:7.29.0;
locked io.cucumber:cucumber-junit:7.29.0;
locked io.repaint.maven:tiles-maven-plugin:2.41;
locked io.vavr:vavr:0.10.7;
locked junit:junit:4.13.2;
locked org.antlr:antlr4-maven-plugin:4.13.2;
locked org.antlr:antlr4-runtime:4.13.2;
locked org.apache.commons:commons-lang3:3.18.0;
locked org.apache.maven.plugins:maven-assembly-plugin:3.7.1;
locked org.apache.maven.plugins:maven-deploy-plugin:3.1.4;
locked org.apache.maven.plugins:maven-failsafe-plugin:3.5.4;
locked org.apache.maven.plugins:maven-install-plugin:3.1.4;
locked org.apache.maven.plugins:maven-jar-plugin:3.4.2;
locked org.apache.maven.plugins:maven-site-plugin:3.21.0;
locked org.apache.maven.plugins:maven-source-plugin:3.3.1;
locked org.apache.maven.plugins:maven-surefire-plugin:3.5.4;
locked org.apache.maven.resolver:maven-resolver-api:1.9.24;
locked org.apache.maven.resolver:maven-resolver-connector-basic:1.9.24;
locked org.apache.maven.resolver:maven-resolver-impl:1.9.24;
locked org.apache.maven.resolver:maven-resolver-spi:1.9.24;
locked org.apache.maven.resolver:maven-resolver-transport-file:1.9.24;
locked org.apache.maven.resolver:maven-resolver-transport-http:1.9.24;
locked org.apache.maven.resolver:maven-resolver-util:1.9.24;
locked org.apache.maven:maven-artifact:3.9.11;
locked org.apache.maven:maven-resolver-provider:3.9.11;
locked org.bitbucket.cowwoc:diff-match-patch:1.2;
locked org.immutables:value:2.11.3;
